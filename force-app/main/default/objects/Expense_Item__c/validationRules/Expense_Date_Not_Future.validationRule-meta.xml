<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expense_Date_Not_Future</fullName>
    <active>true</active>
    <description>Expense Date cannot be in the future.</description>
    <errorConditionFormula>Expense_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Expense_Date__c</errorDisplayField>
    <errorMessage>Expense Date cannot be in the future.</errorMessage>
</ValidationRule>
